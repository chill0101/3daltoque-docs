erDiagram
  cuentas_pago {
    UUID id PK
    Texto estado
  }
  pagos {
    UUID id PK
    UUID compra_id FK
    Moneda moneda
    EstadoPago estado
  }
  intentos_pago {
    UUID id PK
    UUID pago_id FK
    UUID cuenta_pago_id FK
    Moneda moneda
    EstadoIntento estado
  }
  operaciones_pago {
    UUID id PK
    UUID intento_id FK
    UUID cuenta_pago_id FK
    Moneda moneda
  }
  eventos_proveedor {
    UUID id PK
    UUID cuenta_pago_id FK
    UUID operacion_pago_id FK
  }
  reembolsos {
    UUID id PK
    UUID pago_id FK
    UUID operacion_cobro_id FK
    UUID operacion_resultado_id FK
    UUID solicitado_por FK
    Moneda moneda
    EstadoReembolso estado
  }
  planes_membresia_versiones {
    UUID id PK
    Monto importe
    Moneda moneda
    Texto periodo_unidad
    Entero periodo_cantidad
    UUID configuracion_version_id FK
    UUID creado_por FK
  }
  membresias_maker {
    UUID id PK
    UUID maker_id FK
    Booleano es_fundador
    UUID fundador_configuracion_id FK
    UUID fundador_asignado_por FK
  }
  compras_membresia {
    UUID id PK
    UUID membresia_id FK
    UUID plan_version_id FK
    Monto importe
    Moneda moneda
    Texto periodo_unidad
    Entero periodo_cantidad
    EstadoCompra estado
  }
  periodos_membresia {
    UUID id PK
    UUID membresia_id FK
    OrigenAcceso origen
    UUID compra_id FK
    UUID configuracion_version_id FK
    FechaHora inicio_en
    FechaHora fin_en
    EstadoPeriodo estado
  }
  usuarios {
    UUID id PK
  }
  configuraciones_versiones {
    UUID id PK
    UUID creada_por FK
  }
  makers {
    UUID id PK
    UUID usuario_id FK
    UUID ubicacion_id FK
  }
  compras_membresia ||--o| pagos : "compra_id"
  pagos ||--o{ intentos_pago : "pago_id"
